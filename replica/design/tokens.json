{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "name": "desktop-commander-design-tokens",
  "version": "1.0.0",
  "tokens": {
    "process": {
      "default_timeout_ms": 30000,
      "max_wait_ms": 240000,
      "buffer_capacity_bytes": 52428800,
      "wait_output_capacity_bytes": 2097152,
      "states": [
        "idle",
        "running",
        "waiting_for_input",
        "completed",
        "terminated",
        "failed"
      ]
    },
    "filesystem": {
      "default_read_limit": 1000,
      "max_read_limit": 10000,
      "max_file_size_bytes": 52428800,
      "atomic_write_suffix": ".tmp"
    },
    "edit": {
      "fuzzy_similarity_threshold": 0.7,
      "default_expected_replacements": 1,
      "sliding_window_padding_lines": 3
    },
    "search": {
      "default_context_lines": 5,
      "default_page_size": 100,
      "max_results_default": 1000,
      "session_ttl_seconds": 600
    },
    "transport": {
      "protocol": "jsonrpc-2.0",
      "mcp_version": "2024-11-05",
      "ipc_uds_path": "/tmp/desktop-commander-mcp.sock",
      "ipc_tcp_port": 50051
    },
    "terminal_colors": {
      "bg": "#1e1e1e",
      "surface": "#252526",
      "border": "#3c3c3c",
      "text": "#d4d4d4",
      "text_muted": "#858585",
      "accent": "#007acc",
      "success": "#4ec9b0",
      "warning": "#ce9178",
      "danger": "#f14c4c"
    }
  }
}
